# Private server settings. Copy to .env.local, then restart npm run dev.
# Never use VITE_ for credentials. Configure these in Vercel for hosting.
GROQ_API_KEY=
# Choose a different strong password for access to this app's AI service.
AI_ACCESS_PASSWORD=
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROQ_MODEL=openai/gpt-oss-20b
